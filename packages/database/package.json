{
  "name": "@mettlo/database",
  "version": "0.1.0",
  "private": true,
  "main": "./generated/client/index.js",
  "types": "./generated/client/index.d.ts",
  "scripts": {
    "generate": "prisma generate --schema ../../database/prisma/schema",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev --schema ../../database/prisma/schema",
    "deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema ../../database/prisma/schema",
    "studio": "dotenv -e ../../.env -- prisma studio --schema ../../database/prisma/schema",
    "seed": "dotenv -e ../../.env -- tsx ../../database/prisma/seed/seed.ts",
    "build": "prisma generate --schema ../../database/prisma/schema"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/client-runtime-utils": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv-cli": "^11.1.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
