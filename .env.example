# Sirlar sunucudaki .env dosyasinda tutulur; bu dosya sadece anahtar listesidir.
NODE_ENV=production
APP_URL=https://mettlo.tr
API_URL=https://mettlo.tr/api
MEMBER_WEB_PORT=3300
API_PORT=3301
CREATOR_WEB_PORT=3302
ADMIN_WEB_PORT=3303
DATABASE_URL=
REDIS_URL=
REDIS_PREFIX=mettlo
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=
FIELD_ENCRYPTION_KEY=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
BUNNY_STREAM_API_KEY=
BUNNY_LIBRARY_ID=
SES_ACCESS_KEY=
SES_SECRET_KEY=
SES_REGION=
SENTRY_DSN=
# Sosyal giriş (üye girişi): boş bırakılırsa düğmeler "henüz etkinleştirilmedi" uyarısı gösterir
# Google Cloud > OAuth istemcisi; yetkili yönlendirme URI: https://mettlo.tr/auth/social/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Developer > Services ID (Sign in with Apple); dönüş URL: https://mettlo.tr/auth/social/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
