// ============ ÜYELİK / YETKİLENDİRME (ENTITLEMENT) / REZERVASYON / YORUM / FATURA ============

model SubscriptionPlan {
  id            String          @id @default(cuid())
  creatorId     String
  creator       User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  /// Web ve mağaza fiyatı ayrı belirlenir; mobil biraz yüksek (bölüm 22)
  priceWeb      Decimal         @db.Decimal(12, 2)
  priceMobile   Decimal?        @db.Decimal(12, 2)
  interval      BillingInterval @default(MONTHLY)
  features      Json?
  isPremiumLive Boolean         @default(false)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())

  subscriptions Subscription[]

  @@index([creatorId, isActive])
  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  memberId           String
  member             User               @relation("MemberSubscriptions", fields: [memberId], references: [id], onDelete: Cascade)
  creatorId          String
  creator            User               @relation("CreatorSubscribers", fields: [creatorId], references: [id])
  planId             String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(ACTIVE)
  channel            PaymentChannel     @default(WEB_IYZICO)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  pausedAt           DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  entitlements Entitlement[]

  @@index([memberId, status])
  @@index([creatorId, status])
  @@map("subscriptions")
}

/// Ücretli erişimi SADECE sistem açar; koç elle erişim veremez (bölüm 23)
model Entitlement {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorId      String?
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  /// Program/canlı/sınıf gibi tekil ürünler için
  targetType     String?
  targetId       String?
  source         EntitlementSource
  status         EntitlementStatus @default(ACTIVE)
  startsAt       DateTime          @default(now())
  endsAt         DateTime?
  graceUntil     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  events EntitlementEvent[]

  @@index([userId, status])
  @@index([creatorId, status])
  @@index([targetType, targetId])
  @@map("entitlements")
}

model EntitlementEvent {
  id            String             @id @default(cuid())
  entitlementId String
  entitlement   Entitlement        @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  fromStatus    EntitlementStatus?
  toStatus      EntitlementStatus
  reason        String?
  actorId       String?
  createdAt     DateTime           @default(now())

  @@index([entitlementId, createdAt])
  @@map("entitlement_events")
}

/// Bir kerelik beyan edilen kota; her davet 1-25 gün (26-30 yasak)
model CreatorInviteGrant {
  id           String    @id @default(cuid())
  creatorId    String
  creator      User      @relation("InviteGrantCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  inviteeEmail String?
  inviteeId    String?
  days         Int
  token        String    @unique
  acceptedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([creatorId])
  @@map("creator_invite_grants")
}

// ---------- Rezervasyon ----------

model AvailabilitySlot {
  id          String    @id @default(cuid())
  creatorId   String
  creator     User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  /// 0=Pazar .. 6=Cumartesi; istisnalar için date dolu
  weekday     Int?
  date        DateTime? @db.Date
  startTime   String
  endTime     String
  timezone    String    @default("Europe/Istanbul")
  isException Boolean   @default(false)
  isBlocked   Boolean   @default(false)

  @@index([creatorId])
  @@map("availability_slots")
}

model CancellationPolicy {
  id              String  @id @default(cuid())
  creatorId       String?
  name            String
  freeCancelHours Int     @default(24)
  refundPctAfter  Int     @default(0)
  isDefault       Boolean @default(false)

  classSessions ClassSession[]

  @@map("cancellation_policies")
}

model ClassSession {
  id                   String              @id @default(cuid())
  creatorId            String
  creator              User                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  branchId             String?
  /// /class/{slug}
  slug                 String              @unique
  title                String
  description          String?
  type                 ClassSessionType
  startsAt             DateTime
  endsAt               DateTime
  capacity             Int                 @default(1)
  bookedCount          Int                 @default(0)
  price                Decimal?            @db.Decimal(12, 2)
  includedInMembership Boolean             @default(false)
  waitlistEnabled      Boolean             @default(true)
  recurrenceRule       String?
  policyId             String?
  policy               CancellationPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  isCancelled          Boolean             @default(false)
  createdAt            DateTime            @default(now())

  bookings Booking[]
  waitlist BookingWaitlist[]

  @@index([creatorId, startsAt])
  @@map("class_sessions")
}

model Booking {
  id                 String        @id @default(cuid())
  sessionId          String
  session            ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId           String
  member             User          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status             BookingStatus @default(CONFIRMED)
  entitlementId      String?
  paymentId          String?
  /// Reşit olmayan için ebeveyn onayı (1:1 canlı)
  guardianApprovedAt DateTime?
  cancelledAt        DateTime?
  attendedAt         DateTime?
  createdAt          DateTime      @default(now())

  @@unique([sessionId, memberId])
  @@index([memberId])
  @@map("bookings")
}

model BookingWaitlist {
  id         String       @id @default(cuid())
  sessionId  String
  session    ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId   String
  position   Int
  notifiedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([sessionId, memberId])
  @@map("booking_waitlists")
}

model SessionPack {
  id                 String   @id @default(cuid())
  /// null = platform paketi (1:1 görüntülü koçluk); dolu = koça özel paket
  creatorId          String?
  name               String
  sessions           Int
  priceWeb           Decimal  @db.Decimal(12, 2)
  /// iOS/Android mağaza fiyatı (null = web fiyatı kullanılır)
  priceMobile        Decimal? @db.Decimal(12, 2)
  validDays          Int      @default(90)
  /// true = 1:1 görüntülü koçluk oturumu; false = eski koça-özel seans paketi
  isVideoCoaching    Boolean  @default(false)
  /// Oturum başına planlanan süre (dakika)
  sessionDurationMin Int      @default(60)
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  balances VideoSessionBalance[]

  @@index([isVideoCoaching, isActive])
  @@map("session_packs")
}

/// Kullanıcının satın aldığı 1:1 görüntülü koçluk oturumu bakiyesi
model VideoSessionBalance {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation("VideoSessionBalanceUser", fields: [userId], references: [id], onDelete: Cascade)
  packId    String
  pack      SessionPack @relation(fields: [packId], references: [id])
  total     Int
  remaining Int
  paymentId String?
  expiresAt DateTime
  createdAt DateTime    @default(now())

  consumptions VideoSessionConsumption[]

  @@index([userId, remaining])
  @@map("video_session_balances")
}

/// Bir oturum tüketimi: bakiyeden 1 oturum düşüldüğünde (COMPLETED sonrası, idempotent)
model VideoSessionConsumption {
  id          String              @id @default(cuid())
  balanceId   String
  balance     VideoSessionBalance @relation(fields: [balanceId], references: [id])
  /// 1:1 görüntülü oturum (live_sessions.id)
  sessionId   String              @unique
  consumedAt  DateTime            @default(now())

  @@index([balanceId])
  @@map("video_session_consumptions")
}

// ---------- Yorumlar ----------

model Review {
  id         String       @id @default(cuid())
  authorId   String
  author     User         @relation(fields: [authorId], references: [id])
  targetType ReviewTarget
  targetId   String
  rating     Int
  body       String?
  tags       String[]
  status     ReviewStatus @default(PUBLISHED)
  /// Hesap silinince yorum anonimleşir ama puan bütünlüğü için kalır
  anonymized Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  replies ReviewReply[]
  reports ReviewReport[]

  @@unique([authorId, targetType, targetId])
  @@index([targetType, targetId, status])
  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([reviewId])
  @@map("review_replies")
}

model ReviewReport {
  id         String       @id @default(cuid())
  reviewId   String
  review     Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId String
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@index([reviewId])
  @@map("review_reports")
}

// ---------- Fatura (Mettlo faturayı keser; üyeye tek KDV dahil fiyat) ----------

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  paymentId     String?
  orderId       String?
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(12, 2)
  kdv           Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  currency      String        @default("TRY")
  pdfUrl        String?
  integratorRef String?
  issuedAt      DateTime?
  createdAt     DateTime      @default(now())

  items       InvoiceItem[]
  creditNotes CreditNote[]
  events      InvoiceEvent[]

  @@index([userId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  kdvRate     Decimal @db.Decimal(4, 2)
  total       Decimal @db.Decimal(12, 2)

  @@map("invoice_items")
}

model CreditNote {
  id        String   @id @default(cuid())
  number    String   @unique
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  refundId  String?
  total     Decimal  @db.Decimal(12, 2)
  pdfUrl    String?
  issuedAt  DateTime @default(now())

  @@map("credit_notes")
}

model InvoiceEvent {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_events")
}
