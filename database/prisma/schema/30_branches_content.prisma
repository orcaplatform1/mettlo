// ============ BRANŞLAR / İÇERİK / ANTRENMAN / PROGRAM / CHALLENGE ============

model Branch {
  id                  String        @id @default(cuid())
  /// /category/{slug}
  slug                String        @unique
  name                String
  description         String?
  imageUrl            String?
  allowedContentTypes ContentType[]
  /// hangi blok tipleri açık: STRENGTH / TIMED_FLOW / CARDIO / FREE
  sessionTemplate     BlockType[]
  levelScale          Json?
  equipment           String[]
  /// Beslenme branşı gibi hukuki inceleme gerektirenler kapalı açılır
  requiresLegalReview Boolean       @default(false)
  creatorRequirements Json?
  commerceCategoryIds String[]
  isActive            Boolean       @default(true)
  sortOrder           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  metricSets    BranchMetricSet[]
  creators      CreatorBranch[]
  categories    ContentCategory[]
  subCategories BranchSubCategory[]

  @@map("branches")
}

model BranchMetricSet {
  id       String       @id @default(cuid())
  branchId String
  branch   Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  metric   HealthMetric

  @@unique([branchId, metric])
  @@map("branch_metric_sets")
}

model ContentCategory {
  id       String            @id @default(cuid())
  branchId String?
  branch   Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  slug     String            @unique
  name     String
  parentId String?
  parent   ContentCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ContentCategory[] @relation("CategoryTree")

  @@map("content_categories")
}

model CreatorBranch {
  creatorId String
  branchId  String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isPrimary Boolean        @default(false)

  @@id([creatorId, branchId])
  @@map("creator_branches")
}

// ---------- Medya ----------

model Media {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind       MediaKind
  url        String
  storageKey String?
  mimeType   String?
  sizeBytes  BigInt?
  width      Int?
  height     Int?
  altText    String?
  isPrivate  Boolean   @default(false)
  createdAt  DateTime  @default(now())

  video    Video?
  document Document?

  @@index([ownerId])
  @@map("media")
}

model Video {
  id               String   @id @default(cuid())
  mediaId          String   @unique
  media            Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  /// Bunny Stream video id
  providerVideoId  String?
  hlsUrl           String?
  thumbnailUrl     String?
  durationSec      Int?
  processingStatus String   @default("pending")
  createdAt        DateTime @default(now())

  @@map("videos")
}

model Document {
  id        String   @id @default(cuid())
  mediaId   String   @unique
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  pageCount Int?
  createdAt DateTime @default(now())

  @@map("documents")
}

// ---------- İçerik ----------

model Content {
  id           String             @id @default(cuid())
  creatorId    String
  creator      User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  branchId     String?
  /// /content/{slug}
  slug         String             @unique
  type         ContentType
  title        String
  description  String?
  body         Json?
  thumbnailUrl String?
  mediaId      String?
  access       ContentAccessLevel @default(MEMBERS_ONLY)
  status       ContentStatus      @default(DRAFT)
  price        Decimal?           @db.Decimal(12, 2)
  tags         String[]
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  accessRules ContentAccess[]

  @@index([creatorId, status])
  @@index([branchId, type, status])
  @@map("contents")
}

model ContentAccess {
  id        String    @id @default(cuid())
  contentId String
  content   Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  /// Belirli koç aboneliği/plan/paket bazlı erişim
  planId    String?
  userId    String?
  grantedAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([contentId])
  @@index([userId])
  @@map("content_access")
}

// ---------- Egzersiz / antrenman ----------

model Exercise {
  id           String   @id @default(cuid())
  creatorId    String?
  branchId     String?
  name         String
  slug         String   @unique
  category     String?
  muscleGroup  String?
  equipment    String[]
  difficulty   Level?
  instructions String?
  videoUrl     String?
  imageUrl     String?
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())

  workoutExercises WorkoutExercise[]

  @@index([branchId])
  @@map("exercises")
}

model Workout {
  id           String        @id @default(cuid())
  creatorId    String
  creator      User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  branchId     String?
  slug         String        @unique
  title        String
  description  String?
  level        Level?
  equipment    String[]
  durationMin  Int?
  caloriesEst  Int?
  notes        String?
  videoUrl     String?
  thumbnailUrl String?
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  blocks          WorkoutBlock[]
  logs            WorkoutLog[]
  programWorkouts ProgramWorkout[]

  @@index([creatorId, status])
  @@map("workouts")
}

model WorkoutBlock {
  id        String    @id @default(cuid())
  workoutId String
  workout   Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  position  Int
  type      BlockType
  title     String?
  /// TIMED_FLOW / CARDIO / FREE alanları (süre, sıra, odak, nefes, hedef bölge, not)
  config    Json?

  exercises WorkoutExercise[]

  @@unique([workoutId, position])
  @@map("workout_blocks")
}

model WorkoutExercise {
  id         String       @id @default(cuid())
  blockId    String
  block      WorkoutBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise     @relation(fields: [exerciseId], references: [id])
  position   Int
  sets       Int?
  reps       String?
  weightKg   Decimal?     @db.Decimal(6, 2)
  restSec    Int?
  tempo      String?
  notes      String?

  @@index([blockId])
  @@map("workout_exercises")
}

model WorkoutLog {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId    String
  workout      Workout   @relation(fields: [workoutId], references: [id])
  /// Hangi koçun alanında yapıldı (koç "kendi alanı" verisi görür)
  creatorId    String?
  enrollmentId String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  durationSec  Int?
  caloriesEst  Int?
  /// set/tekrar/ağırlık girişleri
  entries      Json?
  notes        String?

  @@index([userId, startedAt])
  @@index([creatorId, userId])
  @@map("workout_logs")
}

// ---------- Program ----------

model Program {
  id           String             @id @default(cuid())
  creatorId    String
  creator      User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  branchId     String?
  /// /program/{slug}
  slug         String             @unique
  title        String
  description  String?
  /// 7 / 14 / 30 / 60 / 90 gün
  durationDays Int
  level        Level?
  goal         String?
  imageUrl     String?
  access       ContentAccessLevel @default(PAID)
  priceWeb     Decimal?           @db.Decimal(12, 2)
  priceMobile  Decimal?           @db.Decimal(12, 2)
  ratingAvg    Decimal            @default(0) @db.Decimal(3, 2)
  ratingCount  Int                @default(0)
  status       ContentStatus      @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  weeks       ProgramWeek[]
  enrollments ProgramEnrollment[]

  @@index([creatorId, status])
  @@index([branchId, status])
  @@map("programs")
}

model ProgramWeek {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekNo    Int
  title     String?

  days ProgramDay[]

  @@unique([programId, weekNo])
  @@map("program_weeks")
}

model ProgramDay {
  id     String      @id @default(cuid())
  weekId String
  week   ProgramWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayNo  Int
  title  String?
  isRest Boolean     @default(false)
  notes  String?

  workouts ProgramWorkout[]

  @@unique([weekId, dayNo])
  @@map("program_days")
}

model ProgramWorkout {
  id        String     @id @default(cuid())
  dayId     String
  day       ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  workoutId String
  workout   Workout    @relation(fields: [workoutId], references: [id])
  position  Int        @default(0)

  @@index([dayId])
  @@map("program_workouts")
}

model ProgramEnrollment {
  id            String    @id @default(cuid())
  programId     String
  program       Program   @relation(fields: [programId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlementId String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  currentDay    Int       @default(1)
  progressPct   Decimal   @default(0) @db.Decimal(5, 2)

  @@unique([programId, userId])
  @@index([userId])
  @@map("program_enrollments")
}

// ---------- Challenge ----------

model Challenge {
  id           String        @id @default(cuid())
  creatorId    String?
  creator      User?         @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  /// /challenge/{slug}
  slug         String        @unique
  title        String
  description  String?
  imageUrl     String?
  /// 7 / 14 / 30 gün
  durationDays Int
  startsAt     DateTime?
  endsAt       DateTime?
  rewards      Json?
  xpReward     Int           @default(0)
  badgeId      String?
  isBrand      Boolean       @default(false)
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tasks        ChallengeTask[]
  participants ChallengeParticipant[]

  @@index([creatorId, status])
  @@map("challenges")
}

model ChallengeTask {
  id          String            @id @default(cuid())
  challengeId String
  challenge   Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  dayNo       Int?
  type        ChallengeTaskType
  title       String
  target      Decimal?          @db.Decimal(10, 2)
  unit        String?
  position    Int               @default(0)

  progress ChallengeProgress[]

  @@index([challengeId])
  @@map("challenge_tasks")
}

model ChallengeParticipant {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())
  completedAt DateTime?
  score       Int       @default(0)

  progress ChallengeProgress[]

  @@unique([challengeId, userId])
  @@index([challengeId, score])
  @@map("challenge_participants")
}

model ChallengeProgress {
  id            String               @id @default(cuid())
  participantId String
  participant   ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  taskId        String
  task          ChallengeTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  value         Decimal?             @db.Decimal(10, 2)
  completed     Boolean              @default(false)
  loggedAt      DateTime             @default(now())

  @@index([participantId])
  @@map("challenge_progress")
}
