// ============ SAĞLIK / İLERLEME / BESLENME / OYUNLAŞTIRMA ============
// Sağlık verisi KVKK'da özel nitelikli kişisel veridir. SUPER_ADMIN dahil tüm admin rolleri için
// bireysel sağlık verisi ekranı yoktur (sadece toplu); koçlar yalnızca health_share_consents ile.

model HealthConnection {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    DevicePlatform
  /// APPLE_HEALTH | HEALTH_CONNECT
  provider    String
  connectedAt DateTime       @default(now())
  revokedAt   DateTime?
  lastSyncAt  DateTime?

  @@index([userId])
  @@map("health_connections")
}

model HealthPermission {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric    HealthMetric
  granted   Boolean      @default(false)
  updatedAt DateTime     @updatedAt

  @@unique([userId, metric])
  @@map("health_permissions")
}

model HealthRecord {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric     HealthMetric
  value      Decimal      @db.Decimal(14, 3)
  unit       String
  source     String?
  recordedAt DateTime
  createdAt  DateTime     @default(now())

  @@index([userId, metric, recordedAt])
  @@map("health_records")
}

model ActivityRecord {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  steps          Int?
  distanceM      Int?
  activeCalories Int?
  exerciseMin    Int?
  avgHeartRate   Int?

  @@unique([userId, date])
  @@map("activity_records")
}

model SleepRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  durationMin Int
  quality     Int?
  stages      Json?

  @@unique([userId, date])
  @@map("sleep_records")
}

model ProgressRecord {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  value      Decimal  @db.Decimal(12, 3)
  unit       String?
  recordedAt DateTime @default(now())

  @@index([userId, kind, recordedAt])
  @@map("progress_records")
}

model Measurement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Decimal? @db.Decimal(5, 2)
  bodyFatPct Decimal? @db.Decimal(4, 1)
  chestCm    Decimal? @db.Decimal(5, 1)
  waistCm    Decimal? @db.Decimal(5, 1)
  hipCm      Decimal? @db.Decimal(5, 1)
  armCm      Decimal? @db.Decimal(5, 1)
  thighCm    Decimal? @db.Decimal(5, 1)
  measuredAt DateTime @default(now())

  @@index([userId, measuredAt])
  @@map("measurements")
}

model ProgressPhoto {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId String
  angle   String?
  takenAt DateTime @default(now())

  @@index([userId, takenAt])
  @@map("progress_photos")
}

/// Üyenin sağlık verisini belirli bir koçla paylaşma rızası (bölüm 14): koç bazlı, zaman damgalı, geri alınabilir
model HealthShareConsent {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation("HealthConsentMember", fields: [userId], references: [id], onDelete: Cascade)
  creatorId          String
  creator            User      @relation("HealthConsentCoach", fields: [creatorId], references: [id], onDelete: Cascade)
  consentTextVersion String
  grantedAt          DateTime  @default(now())
  revokedAt          DateTime?
  ip                 String?

  @@index([userId])
  @@index([creatorId, revokedAt])
  @@map("health_share_consents")
}

// ---------- Beslenme ----------

model NutritionProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calorieTarget Int?
  proteinG      Int?
  carbG         Int?
  fatG          Int?
  waterMl       Int?
  preferences   Json?
  updatedAt     DateTime @updatedAt

  @@map("nutrition_profiles")
}

model NutritionLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  mealId    String?
  meal      Meal?    @relation(fields: [mealId], references: [id], onDelete: SetNull)
  label     String?
  calories  Int?
  proteinG  Decimal? @db.Decimal(6, 1)
  carbG     Decimal? @db.Decimal(6, 1)
  fatG      Decimal? @db.Decimal(6, 1)
  waterMl   Int?
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@map("nutrition_logs")
}

model Recipe {
  id          String        @id @default(cuid())
  creatorId   String?
  /// /recipe/{slug}
  slug        String        @unique
  title       String
  description String?
  imageUrl    String?
  ingredients Json?
  steps       Json?
  calories    Int?
  proteinG    Decimal?      @db.Decimal(6, 1)
  carbG       Decimal?      @db.Decimal(6, 1)
  fatG        Decimal?      @db.Decimal(6, 1)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())

  meals Meal[]

  @@map("recipes")
}

model Meal {
  id       String   @id @default(cuid())
  recipeId String?
  recipe   Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  name     String
  calories Int?
  proteinG Decimal? @db.Decimal(6, 1)
  carbG    Decimal? @db.Decimal(6, 1)
  fatG     Decimal? @db.Decimal(6, 1)

  logs NutritionLog[]

  @@map("meals")
}

// ---------- Oyunlaştırma ----------

model XpRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("xp_records")
}

model Streak {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  current      Int       @default(0)
  longest      Int       @default(0)
  lastActiveOn DateTime? @db.Date

  @@map("streaks")
}

model Badge {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  iconUrl     String?
  createdAt   DateTime @default(now())

  achievements Achievement[]

  @@map("badges")
}

model Achievement {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String?
  badge    Badge?   @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  key      String
  earnedAt DateTime @default(now())

  @@unique([userId, key])
  @@map("achievements")
}

model Leaderboard {
  id       String    @id @default(cuid())
  scope    String
  scopeRef String?
  period   String
  startsAt DateTime?
  endsAt   DateTime?

  entries LeaderboardEntry[]

  @@map("leaderboards")
}

model LeaderboardEntry {
  id            String      @id @default(cuid())
  leaderboardId String
  leaderboard   Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  userId        String
  score         Int
  rank          Int?

  @@unique([leaderboardId, userId])
  @@index([leaderboardId, score])
  @@map("leaderboard_entries")
}
