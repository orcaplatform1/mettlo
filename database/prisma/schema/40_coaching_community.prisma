// ============ KOÇLUK / TOPLULUK / MESAJLAŞMA ============

model CoachingPackage {
  id           String   @id @default(cuid())
  creatorId    String
  creator      User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  isVip        Boolean  @default(false)
  durationDays Int?
  priceWeb     Decimal  @db.Decimal(12, 2)
  priceMobile  Decimal? @db.Decimal(12, 2)
  features     Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  clients CoachingClient[]

  @@index([creatorId, isActive])
  @@map("coaching_packages")
}

model CoachingClient {
  id            String           @id @default(cuid())
  creatorId     String
  creator       User             @relation("CoachClients", fields: [creatorId], references: [id], onDelete: Cascade)
  memberId      String
  member        User             @relation("MemberCoaches", fields: [memberId], references: [id], onDelete: Cascade)
  packageId     String?
  package       CoachingPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  entitlementId String?
  status        CoachingStatus   @default(ACTIVE)
  goal          String?
  startedAt     DateTime         @default(now())
  endedAt       DateTime?

  checkins CoachingCheckin[]
  notes    CoachingNote[]

  @@unique([creatorId, memberId])
  @@index([memberId])
  @@map("coaching_clients")
}

model CoachingCheckin {
  id            String         @id @default(cuid())
  clientId      String
  client        CoachingClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  weekNo        Int?
  answers       Json?
  weightKg      Decimal?       @db.Decimal(5, 2)
  photoMediaIds String[]
  coachReply    String?
  repliedAt     DateTime?
  createdAt     DateTime       @default(now())

  @@index([clientId, createdAt])
  @@map("coaching_checkins")
}

model CoachingNote {
  id        String         @id @default(cuid())
  clientId  String
  client    CoachingClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime       @default(now())

  @@index([clientId])
  @@map("coaching_notes")
}

// ---------- Topluluk ----------

model Community {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// /community/{slug}
  slug            String   @unique
  name            String
  description     String?
  coverUrl        String?
  isPrivate       Boolean  @default(false)
  subscribersOnly Boolean  @default(false)
  createdAt       DateTime @default(now())

  members CommunityMember[]
  posts   Post[]

  @@map("communities")
}

model CommunityMember {
  communityId String
  userId      String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member")
  joinedAt    DateTime  @default(now())

  @@id([communityId, userId])
  @@map("community_members")
}

model Post {
  id             String        @id @default(cuid())
  authorId       String
  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  communityId    String?
  community      Community?    @relation(fields: [communityId], references: [id], onDelete: SetNull)
  body           String
  mediaIds       String[]
  isAnnouncement Boolean       @default(false)
  isPoll         Boolean       @default(false)
  pollOptions    Json?
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  comments Comment[]

  @@index([communityId, createdAt])
  @@index([authorId])
  @@map("posts")
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  body      String
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())

  @@index([postId, createdAt])
  @@map("comments")
}

model Reaction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  kind       String   @default("like")
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("reactions")
}

// ---------- Mesajlaşma (DM / koç-üye) ----------
// Koç mesaj kutusu: SUPER_ADMIN, admin panelinde koç profilinden "Koç Mesaj Kutusu" ile
// koçun tüm conversation'larını ve mesajlarını okuyabilir (her erişim audit_logs'a yazılır).

model Conversation {
  id            String           @id @default(cuid())
  kind          ConversationKind @default(DIRECT)
  title         String?
  /// Reşit olmayan profil içeren konuşmalar ebeveyne görünür (bölüm 58)
  involvesMinor Boolean          @default(false)
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  mutedAt        DateTime?
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String?
  mediaIds       String[]
  /// Hesap silinince içerik silinir, gönderen "Silinmiş kullanıcı" görünür
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}
